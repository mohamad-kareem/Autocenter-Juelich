# Copy the new keys below into your existing .env.local (and into Vercel → Settings → Environment Variables)

# --- existing ---
MONGODB_URI=
JWT_SECRET=
MOBILEDE_USERNAME=
MOBILEDE_PASSWORD=
MOBILEDE_SELLER_ID=
SMTP_HOST=smtps.udag.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- NEW: Google reviews on the homepage (Google Cloud → enable "Places API (New)") ---
GOOGLE_PLACES_API_KEY=
# optional – if empty, the place is found automatically by name + address
GOOGLE_PLACE_ID=

# --- NEW: AI chat assistant (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# optional – defaults to gemini-2.5-flash
GEMINI_MODEL=
